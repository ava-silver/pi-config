# Ignore Pi runtime state by default.
*

!/.gitignore
!/.pre-commit-config.yaml
!/AGENTS.md
!/keybindings.json
!/README.md
!/settings.example.json
!/setup.sh
!/web-search.json

!/scripts/
!/scripts/**

!/skills/
!/skills/**

!/extensions/
!/extensions/**
/extensions/node_modules/
/extensions/trajectory/
/extensions/pi-session-auto-rename.json

!/prompts/
!/prompts/**

!/themes/
!/themes/**
