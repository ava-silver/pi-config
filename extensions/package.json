{
  "name": "pi-extensions",
  "private": true,
  "description": "Local Pi extensions",
  "type": "module",
  "scripts": {
    "check": "bun run format:check && bun run lint && bun run typecheck && bun run test",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "lint": "oxlint --quiet --type-aware --report-unused-disable-directives --ignore-pattern trajectory .",
    "prepare": "effect-tsgo patch",
    "test": "bun test --parallel --only-failures",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@ff-labs/fff-bun": "0.11.0",
    "acorn": "8.19.0",
    "effect": "4.0.5",
    "js-tiktoken": "^1.0.21",
    "kokoro-js": "1.2.1",
    "pi-web-access": "0.41.0"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "1.3.0",
    "@earendil-works/pi-coding-agent": "1.3.0",
    "@earendil-works/pi-server": "1.1.0",
    "@earendil-works/pi-tui": "1.3.0",
    "@effect/tsgo": "0.53.3",
    "@oxlint/plugins": "1.88.0",
    "@types/node": "26.6.5",
    "oxfmt": "0.73.0",
    "oxlint": "1.88.0",
    "oxlint-tsgolint": "7.0.2004",
    "typebox": "1.4.1",
    "typescript": "7.0.2"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "engines": {
    "node": ">=24.17.0"
  },
  "packageManager": "bun@1.3.14",
  "trustedDependencies": [
    "onnxruntime-node",
    "sharp"
  ]
}
