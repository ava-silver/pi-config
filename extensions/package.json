{
  "name": "pi-extensions",
  "private": true,
  "description": "Local Pi extensions",
  "type": "module",
  "scripts": {
    "check": "bun run format:check && bun run lint && bun run typecheck && bun run test",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "lint": "oxlint --type-aware --report-unused-disable-directives --ignore-pattern trajectory .",
    "prepare": "effect-tsgo patch",
    "test": "bun test --parallel",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "acorn": "8.18.0",
    "effect": "4.0.0-beta.98",
    "js-tiktoken": "^1.0.21",
    "kokoro-js": "1.2.1",
    "pi-web-access": "0.24.2"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "0.84.4",
    "@earendil-works/pi-coding-agent": "0.84.4",
    "@earendil-works/pi-tui": "0.84.4",
    "@effect/tsgo": "0.37.0",
    "@oxlint/plugins": "1.80.0",
    "@types/node": "26.3.0",
    "oxfmt": "0.65.0",
    "oxlint": "1.80.0",
    "oxlint-tsgolint": "7.0.2001",
    "typebox": "1.3.19",
    "typescript": "7.0.2"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "engines": {
    "node": ">=24.17.0"
  },
  "packageManager": "bun@1.3.14",
  "trustedDependencies": [
    "onnxruntime-node",
    "sharp"
  ]
}
