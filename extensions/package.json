{
  "name": "pi-extensions",
  "private": true,
  "description": "Local Pi extensions",
  "type": "module",
  "scripts": {
    "verify": "bun fmt --check && bun run lint && bun check && bun run test",
    "lint": "oxlint --quiet --type-aware --report-unused-disable-directives --ignore-pattern trajectory .",
    "prepare": "effect-tsgo patch",
    "test": "bun test --parallel --only-failures"
  },
  "dependencies": {
    "acorn": "8.19.0",
    "effect": "4.1.3",
    "js-tiktoken": "^1.0.21",
    "kokoro-js": "1.2.1",
    "pi-web-access": "0.47.0"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "1.5.2",
    "@earendil-works/pi-coding-agent": "1.5.2",
    "@earendil-works/pi-server": "1.1.0",
    "@earendil-works/pi-tui": "1.5.2",
    "@effect/tsgo": "0.67.7",
    "@oxlint/plugins": "1.93.0",
    "@types/node": "26.6.6",
    "oxlint": "1.93.0",
    "oxlint-tsgolint": "7.0.2006",
    "typebox": "1.4.6",
    "typescript": "7.0.2"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "engines": {
    "node": ">=24.17.0"
  },
  "packageManager": "bun@1.3.14",
  "trustedDependencies": [
    "onnxruntime-node",
    "sharp"
  ]
}
