{
  "npmCommand": [
    "bun"
  ],
  "warnings": {
    "anthropicExtraUsage": false
  },
  "lastChangelogVersion": "1.3.0",
  "theme": "catppuccin-frappe",
  "defaultThinkingLevel": "medium",
  "quietStartup": true,
  "hideThinkingBlock": false,
  "packages": [
    "npm:pi-btw",
    "npm:pi-auto-rename",
    "~/go/src/github.com/DataDog/datadog-pi-packages/packages/dd-ai-gateway"
  ],
  "extensions": [
    "-extensions/workflows/index.ts",
    "-extensions/trajectory/index.ts",
    "-extensions/ui-performance.ts"
  ],
  "skills": [
    "~/skills/skills",
    "~/dd/claude-marketplace/serverless/skills",
    "~/dd/experimental/users/ava.silver/ssi/skills/"
  ],
  "defaultProvider": "baseten",
  "defaultModel": "baseten/moonshotai/Kimi-K3",
  "enabledModels": [
    "anthropic/claude-opus-5-5",
    "anthropic/claude-sonnet-5-5",
    "openai-codex/gpt-6.1-sol",
    "baseten/deepseek-v4-1-flash"
  ],
  "showCacheMissNotices": true,
  "collapseChangelog": true,
  "compaction": {
    "enabled": true
  },
  "steeringMode": "all"
}