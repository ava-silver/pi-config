{
  "npmCommand": [
    "bun"
  ],
  "warnings": {
    "anthropicExtraUsage": false
  },
  "lastChangelogVersion": "0.85.1",
  "theme": "catppuccin-frappe",
  "defaultThinkingLevel": "medium",
  "quietStartup": true,
  "hideThinkingBlock": false,
  "packages": [
    "npm:pi-btw",
    "npm:pi-auto-rename",
    "~/go/src/github.com/DataDog/datadog-pi-packages/packages/dd-ai-gateway"
  ],
  "extensions": [
    "-extensions/workflows/index.ts",
    "-extensions/trajectory/index.ts",
    "-extensions/ui-performance.ts"
  ],
  "skills": [
    "~/skills/skills",
    "~/dd/claude-marketplace/serverless/skills",
    "~/dd/experimental/users/ava.silver/ssi/skills/"
  ],
  "defaultProvider": "baseten",
  "defaultModel": "baseten/moonshotai/Kimi-K3",
  "enabledModels": [
    "openai-codex/gpt-5.6-sol",
    "openai-codex/gpt-5.6-terra",
    "anthropic/claude-opus-4-8",
    "openai-codex/gpt-5.6-luna",
    "google/gemini-3.8-flash",
    "openai/openai/gpt-6-astra",
    "baseten/baseten/deepseek-ai/DeepSeek-V4-Flash-0731",
    "baseten/baseten/moonshotai/Kimi-K3",
    "baseten/baseten/zai-org/GLM-5.3-Flash",
    "baseten/baseten/zai-org/GLM-5.3-Fast"
  ],
  "showCacheMissNotices": true,
  "collapseChangelog": true,
  "compaction": {
    "enabled": true
  },
  "steeringMode": "all"
}
