{
  "npmCommand": [
    "bun"
  ],
  "warnings": {
    "anthropicExtraUsage": false
  },
  "lastChangelogVersion": "0.85.0",
  "theme": "catppuccin-frappe",
  "defaultThinkingLevel": "medium",
  "quietStartup": true,
  "hideThinkingBlock": false,
  "packages": [
    "npm:pi-btw",
    "npm:pi-auto-rename",
    "~/go/src/github.com/DataDog/datadog-pi-packages/packages/dd-ai-gateway"
  ],
  "extensions": [
    "-extensions/workflows/index.ts",
    "-extensions/trajectory/index.ts",
    "-extensions/ui-performance.ts"
  ],
  "skills": [
    "~/skills/skills",
    "~/dd/claude-marketplace/serverless/skills",
    "~/dd/experimental/users/ava.silver/ssi/skills/"
  ],
  "defaultProvider": "openai-codex",
  "defaultModel": "gpt-5.6-luna",
  "enabledModels": [
    "dd-ai-gateway/baseten/deepseek-ai/DeepSeek-V4-Flash-0731",
    "openai-codex/gpt-5.6-sol",
    "openai-codex/gpt-5.6-terra",
    "anthropic/claude-opus-4-8",
    "openai-codex/gpt-5.6-luna",
    "google/gemini-3.8-flash",
    "openai-codex/gpt-6-astra"
  ]
}